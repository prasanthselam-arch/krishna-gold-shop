PORT=8787

# HTTPS port (self-signed certificate is created on first start). Phones and tablets need
# HTTPS for the camera. Set to 0 to turn HTTPS off.
HTTPS_PORT=8443

# Optional. If empty, a random secret is generated once and stored in the database.
JWT_SECRET=

# First owner account (used only when the database is created).
# Signing in with the default password forces a password change.
SHOP_USERNAME=owner
SHOP_PASSWORD=KrishnaGold@123

# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# Where the database + photos and the backups are stored (defaults: ./data and ./backups)
# DATA_DIR=/mnt/d/krishna-gold/data
# BACKUP_DIR=/mnt/d/krishna-gold/backups

# Part-month interest rule for new pledges (also editable in Settings)
# actual_days | thirty_day_month | round_up_month
PARTIAL_MONTH_POLICY=actual_days
